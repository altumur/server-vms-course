{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asbuilt/unresolved",
  "title": "Facts the extractor saw but could not bind to constants",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["at", "expr", "func", "reason", "what"],
    "properties": {
      "at": {"type": "string"},
      "expr": {"type": "string"},
      "func": {"type": "string"},
      "reason": {"type": "string"},
      "what": {"enum": ["flag", "env", "const", "refusal", "error", "exit", "file"]}
    }
  }
}
