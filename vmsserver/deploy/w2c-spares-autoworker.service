# /etc/systemd/system/w2c-spares-autoworker.service — the one-shot its timer fires: spare evaluators
# (`w2c-spares.sh autoworker`), for the label sets this server covers, as many as `auto_workers_needed on /auto/metrics` says and
# `MAX_EVALUATORS` allows. Each is `systemctl start vms-autoworker-spare@<n>` — its role's unit's template, the same user, groups and key —
# with `SPARE_FOR=<set>` in its one-line file: it takes an offer of its set, or waits holding nothing. Nothing is ever stopped. Why a host unit and not a container:
# `w2c-spares.service`.
[Unit]
Description=w2c: start spare evaluators the console says are missing
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/w2c-spares.sh autoworker
EnvironmentFile=-/etc/w2c/w2c.env
EnvironmentFile=-/etc/vms/vms.env
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Where it writes each spare's label set for the spare's template to read (`$SPARES_ENV`): the one directory it may
# write, kept between runs — a spare restarted by systemd reads its file again.
RuntimeDirectory=w2c-spares
RuntimeDirectoryPreserve=yes
