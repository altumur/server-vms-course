    .then(tset(onStatus(fireAll(st.with("did", List()), 20, Set("a", "b", "c"), "a", false, false, true, 4), 0, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 30, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onCommit(fireAll(st.with("did", List()), 50, Set("a", "b", "c"), "a", false, false, true, 4), 1, 10, true, 4, 50)).then(tcheck((st.target.exists(t => t.v == "b" and t.c == 10)))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 110, Set("a", "b", "c"), "a", false, false, true, 4), 1, { some: true, st: "Follower", lid: "c", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((st.alive == Set("a")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 120, Set("a", "b", "c"), "a", false, false, true, 4), 1, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a")) and (not(st.target.exists(t => t.v == "b"))))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 130, Set("a", "b", "c"), "a", false, false, true, 4), 1, "c", { some: true, st: "Leader", lid: "c", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "c")) and (st.target.exists(t => t.v == "a" and t.c == 10)))))
