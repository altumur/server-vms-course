// -*- mode: Bluespec; -*-
// СГЕНЕРИРОВАНО gen_traces.py из Platform/02-installer/forms/rollout-poll.traces.tsv на срезе
// 244355d161139bd6fe65fd68c7e5134598c21ba3 (44 трасс, 249 строк). Не править руками.
module rolloutpoll_traces {
  import rolloutpoll(SELF="a", VOTERS=Set("a","b","c"), LAST=false, ALLOW_DOWN=false, WAIT=30000, MAX_K=6, MUT=0, TRACK_DID=true).* from "../rolloutpoll"
  action tset(s: St): bool = all { st' = s, answered' = answered, commited' = commited }
  action tinit(v: Set[str], w: int): bool = all { st' = mkInit(v, w), answered' = Set(), commited' = Set() }
  action tcheck(c: bool): bool = all { assert(c), st' = st, answered' = answered, commited' = commited }
  pure def hasDid(ds: List[Did], rec: Did): bool = ds.select(d => d == rec).length() > 0
  run tr_healthy_under_write = tinit(Set("a", "b", "c"), 30000).then(tcheck((st.mst == "polling")))
    .then(tset(onSelf(fireAll(st.with("did", List()), 10, Set("a", "b", "c"), "a", false, false, true, 4), 0, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((hasDid(st.did, recD("tick", 0, -1, Set(), ""))) and (hasDid(st.did, recD("send_status", 0, -1, Set(), ""))) and (st.need == Set("a")) and (st.replied == Set("a")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 20, Set("a", "b", "c"), "a", false, false, true, 4), 0, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.need == Set("a", "b")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 30, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Follower", lid: "b", applied: 9, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((hasDid(st.did, recD("read_commit", -1, 1, Set("a", "b", "c"), ""))) and (st.need == Set()) and (st.reads == Set({ n: 1, who: Set("a", "b", "c") })))))
    .then(tset(onCommit(fireAll(st.with("did", List()), 50, Set("a", "b", "c"), "a", false, false, true, 4), 1, 12, true, 4, 50)).then(tcheck((st.target.exists(t => t.v == "a" and t.c == 12)) and (st.target.exists(t => t.v == "b" and t.c == 12)) and (st.target.exists(t => t.v == "c" and t.c == 12)) and (st.reads == Set()))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 110, Set("a", "b", "c"), "a", false, false, true, 4), 1, { some: true, st: "Follower", lid: "b", applied: 12, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((hasDid(st.did, recD("tick", 1, -1, Set(), ""))) and (st.alive == Set("a")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 120, Set("a", "b", "c"), "a", false, false, true, 4), 1, "b", { some: true, st: "Leader", lid: "b", applied: 14, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 130, Set("a", "b", "c"), "a", false, false, true, 4), 1, "c", { some: true, st: "Follower", lid: "b", applied: 13, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b", "c")) and (st.target.exists(t => t.v == "c" and t.c == 12)))))
    .then(tset(fireAll(st.with("did", List()), 200, Set("a", "b", "c"), "a", false, false, true, 4)).then(tcheck((hasDid(st.did, recD("tick", 2, -1, Set(), ""))) and (hasDid(st.did, recD("pass", -1, -1, Set(), ""))) and (st.mst == "passed"))))

  run tr_rupture_drops_target = tinit(Set("a", "b", "c"), 30000)
    .then(tset(onSelf(fireAll(st.with("did", List()), 10, Set("a", "b", "c"), "a", false, false, true, 4), 0, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 20, Set("a", "b", "c"), "a", false, false, true, 4), 0, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 30, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.reads == Set({ n: 1, who: Set("a", "b", "c") })))))
    .then(tset(onCommit(fireAll(st.with("did", List()), 50, Set("a", "b", "c"), "a", false, false, true, 4), 1, 10, true, 4, 50)).then(tcheck((st.target.exists(t => t.v == "c" and t.c == 10)))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 110, Set("a", "b", "c"), "a", false, false, true, 4), 1, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((st.alive == Set("a")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 120, Set("a", "b", "c"), "a", false, false, true, 4), 1, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 130, Set("a", "b", "c"), "a", false, false, true, 4), 1, "c", { some: false, st: "Follower", lid: "", applied: 0, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((not(st.target.exists(t => t.v == "c"))) and (st.alive == Set("a", "b")))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 210, Set("a", "b", "c"), "a", false, false, true, 4), 2, { some: true, st: "Follower", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((hasDid(st.did, recD("tick", 2, -1, Set(), ""))) and (st.mst == "polling"))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 220, Set("a", "b", "c"), "a", false, false, true, 4), 2, "b", { some: true, st: "Leader", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 230, Set("a", "b", "c"), "a", false, false, true, 4), 2, "c", { some: true, st: "Follower", lid: "b", applied: 11, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.need == Set()) and (hasDid(st.did, recD("read_commit", -1, 2, Set("c"), ""))) and (st.reads == Set({ n: 2, who: Set("c") })))))
    .then(tset(onCommit(fireAll(st.with("did", List()), 250, Set("a", "b", "c"), "a", false, false, true, 4), 2, 20, true, 4, 250)).then(tcheck((st.target.exists(t => t.v == "c" and t.c == 20)))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 310, Set("a", "b", "c"), "a", false, false, true, 4), 3, { some: true, st: "Follower", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 320, Set("a", "b", "c"), "a", false, false, true, 4), 3, "b", { some: true, st: "Leader", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 330, Set("a", "b", "c"), "a", false, false, true, 4), 3, "c", { some: true, st: "Follower", lid: "b", applied: 15, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b")))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 410, Set("a", "b", "c"), "a", false, false, true, 4), 4, { some: true, st: "Follower", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((st.mst == "polling"))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 420, Set("a", "b", "c"), "a", false, false, true, 4), 4, "b", { some: true, st: "Leader", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 430, Set("a", "b", "c"), "a", false, false, true, 4), 4, "c", { some: true, st: "Follower", lid: "b", applied: 20, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b", "c")))))
    .then(tset(fireAll(st.with("did", List()), 500, Set("a", "b", "c"), "a", false, false, true, 4)).then(tcheck((st.mst == "passed"))))

  run tr_not_live_reply = tinit(Set("a", "b", "c"), 30000)
    .then(tset(onSelf(fireAll(st.with("did", List()), 10, Set("a", "b", "c"), "a", false, false, true, 4), 0, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 20, Set("a", "b", "c"), "a", false, false, true, 4), 0, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 30, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Candidate", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.need == Set()) and (st.replied == Set("a", "b", "c")) and (hasDid(st.did, recD("read_commit", -1, 1, Set("a", "b"), ""))) and (st.reads == Set({ n: 1, who: Set("a", "b") })))))
    .then(tset(onCommit(fireAll(st.with("did", List()), 50, Set("a", "b", "c"), "a", false, false, true, 4), 1, 10, true, 4, 50)).then(tcheck((not(st.target.exists(t => t.v == "c"))))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 110, Set("a", "b", "c"), "a", false, false, true, 4), 1, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 120, Set("a", "b", "c"), "a", false, false, true, 4), 1, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 130, Set("a", "b", "c"), "a", false, false, true, 4), 1, "c", { some: true, st: "Follower", lid: "c", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "b")) and (st.need == Set()))))
    .then(tset(fireAll(st.with("did", List()), 200, Set("a", "b", "c"), "a", false, false, true, 4)).then(tcheck((st.mst == "polling"))))

