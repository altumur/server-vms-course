    .then(tset(onStatus(fireAll(st.with("did", List()), 30, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onCommit(fireAll(st.with("did", List()), 50, Set("a", "b", "c"), "a", false, false, true, 4), 1, 10, true, 4, 50)).then(tcheck((st.target.exists(t => t.v == "a" and t.c == 10)))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 120, Set("a", "b", "c"), "a", false, false, true, 4), 1, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((hasDid(st.did, recD("tick", 1, -1, Set(), ""))) and (st.replied == Set()))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 130, Set("a", "b", "c"), "a", false, false, true, 4), 1, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.replied == Set()))))
    .then(tset(fireAll(st.with("did", List()), 200, Set("a", "b", "c"), "a", false, false, true, 4)).then(tcheck((hasDid(st.did, recD("tick", 2, -1, Set(), ""))) and (not(hasDid(st.did, recD("pass", -1, -1, Set(), "")))) and (st.mst == "polling") and (not(st.target.exists(t => t.v == "a"))) and (not(st.target.exists(t => t.v == "b"))) and (not(st.target.exists(t => t.v == "c"))))))

  run tr_read_timeout = tinit(Set("a", "b", "c"), 30000)
    .then(tset(onSelf(fireAll(st.with("did", List()), 10, Set("a", "b", "c"), "a", false, false, true, 4), 0, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 20, Set("a", "b", "c"), "a", false, false, true, 4), 0, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 30, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.reads == Set({ n: 1, who: Set("a", "b", "c") })))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 110, Set("a", "b", "c"), "a", false, false, true, 4), 1, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((hasDid(st.did, recD("tick", 1, -1, Set(), ""))) and (st.need == Set()) and (st.reads == Set({ n: 1, who: Set("a", "b", "c") })))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 120, Set("a", "b", "c"), "a", false, false, true, 4), 1, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 130, Set("a", "b", "c"), "a", false, false, true, 4), 1, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((hasDid(st.did, recD("read_expired", -1, 1, Set(), ""))) and (hasDid(st.did, recD("read_commit", -1, 2, Set("c"), ""))) and (st.reads == Set({ n: 2, who: Set("c") })))))
    .then(tset(onSelf(fireAll(st.with("did", List()), 210, Set("a", "b", "c"), "a", false, false, true, 4), 2, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)).then(tcheck((st.need == Set("a")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 220, Set("a", "b", "c"), "a", false, false, true, 4), 2, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)))
    .then(tset(onStatus(fireAll(st.with("did", List()), 230, Set("a", "b", "c"), "a", false, false, true, 4), 2, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((hasDid(st.did, recD("read_expired", -1, 2, Set(), ""))) and (hasDid(st.did, recD("read_commit", -1, 3, Set("a", "b", "c"), ""))) and (st.reads == Set({ n: 3, who: Set("a", "b", "c") })))))

