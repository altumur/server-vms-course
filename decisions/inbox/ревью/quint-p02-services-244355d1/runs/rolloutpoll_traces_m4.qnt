  run tr_self_no_answer = tinit(Set("a", "b", "c"), 30000)
    .then(tset(onSelf(fireAll(st.with("did", List()), 10, Set("a", "b", "c"), "a", false, false, true, 4), 0, { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), "a", false, true, 4)))
