    .then(tset(onStatus(fireAll(st.with("did", List()), 220, Set("a", "b", "c"), "a", false, false, true, 4), 2, "b", { some: true, st: "Follower", lid: "c", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.need == Set("b")))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 230, Set("a", "b", "c"), "a", false, false, true, 4), 2, "c", { some: true, st: "Leader", lid: "c", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.alive == Set("a", "c")) and (hasDid(st.did, recD("read_commit", -1, 2, Set("b"), ""))))))

  run tr_held_before_self = tinit(Set("a", "b", "c"), 30000)
    .then(tset(onStatus(fireAll(st.with("did", List()), 10, Set("a", "b", "c"), "a", false, false, true, 4), 0, "b", { some: true, st: "Leader", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.replied == Set()) and (st.need == Set()))))
    .then(tset(onStatus(fireAll(st.with("did", List()), 20, Set("a", "b", "c"), "a", false, false, true, 4), 0, "c", { some: true, st: "Follower", lid: "b", applied: 10, memOK: true }, Set("a", "b", "c"), true, 4)).then(tcheck((st.replied == Set()))))
