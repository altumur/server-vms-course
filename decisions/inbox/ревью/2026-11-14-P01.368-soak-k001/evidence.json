  "norm_M8doubleprime": {
    "course_source": "0fbe6e55ceb0b07e4a70727e813934a2f06edb1b",
    "path": "Platform/01-store/spec/01.1-store.norms.md",
    "R062": "The read MUST be linearizable: it returns a state not older than the last completed write seen by any caller. In a group this means that a read goes through the leader of the current term (a lease renewal is a read, and a follower cut off from the group must not confirm an epoch that the others have already moved; [P/03.2 N3 «renew()» and «confirm(id)»](../../03-worker/spec/03.2-worker.norms.md)). The same guarantee applies to `GET /v1/get` and `GET /v1/list` on a follower's `admin.sock`: they are permitted, without forwarding the admin request (P/01.3-R083). Without confirmation through the current leader within the leader wait, they return `no_leader_wait`, not stale local data; `admin_not_leader` does not apply to these reads. The mechanism — the implementation decides.",
    "R062_unchanged_in_worktree": true
  },
