# /usr/lib/tmpfiles.d/w2c-cluster.conf — the directories of a cluster server.
# Mutable configuration is on the data partition and /etc points there (`install.sh` lays the links): the
# platform's /data/platform/etc (= /etc/w2c: w2c.env, the rights file, tls/, secrets/), the subsystem's /data/vms/etc
# (= /etc/vms: vms.env). The platform's state is the box's layout (WP-E, `vmsserver/deploy/w2c.tmpfiles`, which
# `install-obsd.sh` applies too — the lines both say, they say alike): the key ring 2710 root:w2c-secrets (the key in
# it 0640, `install-obsd.sh`), the objects 2770 w2c:w2c-store, the events archive 2770 w2c:w2c-events — setgid, and
# every unit writes with `UMask=0007`, so whatever a client makes there is its group's and the resource deletes it.
# The store's journal is configstore's alone, and so is what its -api door shows the other servers (tls/).
d /data/platform              0755 root        root        -
d /data/platform/etc          0755 root        root        -
d /data/platform/etc/secrets  2710 root        w2c-secrets -
d /data/platform/etc/tls      0750 root        configstore -
d /data/platform/configstore  0700 configstore configstore -
d /data/platform/objects      2770 w2c         w2c-store   -
d /data/platform/events       2770 w2c         w2c-events  -
d /data/vms                   0755 root        root        -
d /data/vms/etc               0755 root        root        -
