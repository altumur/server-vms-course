# /etc/systemd/system/vms-vmsworker.service — the worker: it HOLDS the camera (one connection, one epoch, one
# fan-out rtsp://<server>:8554/<cam> the recorder and the gateway subscribe to) and writes its events into the
# resource on this server. One per server, its name from the unit (product P4): `w-%l-1` — w-srv-a-1 on srv-a. A
# crash is systemd's to restart under the same name; a dead server is the controller's to act on, by assignment.
# A SPARE of it is `vms-vmsworker-spare@.service`: this unit's lines but the name — `tests/test_units.py` holds the two.
[Unit]
Description=VMS worker — holds its cameras: DriverPack, the fan-out, the events
After=network-online.target configstore.service w2c-resource.service
Wants=network-online.target configstore.service

[Service]
User=vms
Group=vms
# Its store socket's group; the events archive (its events, its registration) and the objects (its heartbeat) of the
# box's layout (WP-E); the key ring's.
SupplementaryGroups=vms-vmsworker w2c-events w2c-store w2c-secrets
Environment=PLATFORM_STORE=configstore:///run/configstore/vmsworker.sock
Environment=WORKER_NAME=w-%l-1
# The fan-out, OPENED: its default is loopback (М10B Lesson 4), and a recorder or a gateway on another server has to
# reach it. Nobody is asked who they are at this door: the cluster's network keeps it closed to everybody else.
Environment=RTSP_HOST=0.0.0.0
# How long it goes on RECORDING past a lease's end while the store does not answer (М10A Lesson 6): longer than
# the slot and its margin, so the recording does not stop before anybody else has been given the camera.
Environment=UNCONFIRMED_MAX=90
LoadCredential=platform.key:/etc/w2c/secrets/platform.key
Environment=SECRETS_KEY=%d/platform.key
# /etc/w2c/w2c.env, then /etc/vms/vms.env: read by w2c-run.sh UNDER what this unit says — `EnvironmentFile=` would
# override `Environment=` (systemd's rule), and the socket and the name above are the unit's, never a file's.
UMask=0007
# The tee's shared memory for subscribers on this server (`SHM_DIR`): made the worker's at its start, kept past its
# stop — the box's `vms.tmpfiles` makes /run/vms root's, and this process is not root.
RuntimeDirectory=vms
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# `simple`, not `notify` (the product's units): the watchdog needs only `NotifyAccess` — the runner `exec`s, so the
# loop is the main process — and under `notify` a SPARE waiting for an offer, which says nothing until it is somebody,
# would hold `systemctl start` (and `w2c-spares.sh` behind it) until its start timed out.
Type=simple
NotifyAccess=main
ExecStart=/opt/w2c/bin/w2c-run.sh worker
Restart=always
RestartSec=2
# Room to release the slot: a stop says so (`release_slot`), a crash cannot.
TimeoutStopSec=20
# THE WATCHDOG (the twelfth review, major 14): the loop says WATCHDOG=1 at every turn (`cluster.worker.notify`); a loop
# that has not turned for six minutes is hung — past the stand-in's five (`STAND_IN_FOR`), well inside the fifteen a
# hung worker keeps its cameras (`HUNG_MOVE_AFTER`) — and systemd kills it and starts the unit again, which claims its
# name back. launchd has no such thing: a hung worker on macOS waits for the fifteen minutes.
WatchdogSec=360
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/platform/events /data/platform/objects
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
