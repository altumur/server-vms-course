// /etc/polkit-1/rules.d/50-w2c-spares.rules — what the spares' script may ask systemd for: `start`, of an instance of
// a spare template, and nothing else (the product's cross-check, 4 Oct; installed by `install.sh --spares`).
//
// `w2c-spares.sh` ran as root, and root may start anything with anything in it. It runs as `w2c-spares` now
// (`w2c-cluster.sysusers`: a user in no group but its own; the spares' timers' units say `User=w2c-spares`), and this
// rule is all that user is let do through systemd: the verb `start` — no stop, no restart, no `reset-failed`, no unit
// file written — of `vms-vmsworker-spare@<n>.service` and `vms-recworker-spare@<n>.service`, the role's units but the
// name (`install.sh`'s SPARE_UNITS; `tests/test_units.py` holds the two lists together). Anything else it asks is
// refused outright, not passed on to an administrator's password prompt nobody is at.
polkit.addRule(function (action, subject) {
    if (subject.user !== "w2c-spares") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") === "start" &&
        /^vms-(vmsworker|recworker)-spare@[1-9][0-9]*\.service$/.test(action.lookup("unit") || "")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NO;
});
