# /etc/vms/vms.env — the VMS subsystem's settings of this server (the platform's are in /etc/w2c/w2c.env).
# Read by `w2c-run.sh` under what each unit says; `install.sh` writes it from this example.

# No ARCHIVE here: the events archive is the platform's (`/etc/w2c/w2c.env`), and this file is read second — a line
# here would win over it. The recorder's own volume, when nothing is declared, is the VMS's: /data/vms/obsd/volume
# (`ARCHIVE_VOLUME` to put it elsewhere).
# What the worker's tee shares with subscribers on this server (shared memory).
SHM_DIR=/run/vms
# Cameras one worker carries on this server: М9 Lesson 7's B + n·I, measured on ITS hardware.
CAPACITY=50
PLAYBACK_PORT=8083
RTP_BASE=20000
# The recorder's archive door: what its heartbeat says (an address), and what it binds.
ARCHIVE_URL=http://10.0.0.1:8084
ARCHIVE_HOST=10.0.0.1
# The console: who scrapes /metrics with its own connections (Prometheus, the spares script on each server).
CONSOLE_MONITORS=127.0.0.1,10.0.0.1
# The cluster's name in its snapshot — what a domain knows it by (М12). Unset: `room-a`, the module's own.
CLUSTER=room-a
LOG_LEVEL=INFO
