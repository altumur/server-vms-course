<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- /Library/LaunchDaemons/com.w2c.resource.plist — the platform's resource: this server's events, objects and their door (М11, a macOS server; the
     systemd unit's twin, deploy/systemd/). `install.sh` puts @HOST@ (this host's short name) in place: launchd has
     no %l. /etc/w2c/w2c.env and /etc/vms/vms.env are read by w2c-run.sh under what this file says. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w2c.resource</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/w2c/bin/w2c-run.sh</string>
		<string>resource</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PLATFORM_STORE</key>
		<string>configstore:///var/run/configstore/resource.sock</string>
		<key>RESOURCE_PORT</key>
		<string>8090</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/w2c/com.w2c.resource.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/w2c/com.w2c.resource.log</string>
</dict>
</plist>
