<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- /Library/LaunchDaemons/com.w2c.vms.recworker.plist — the recorder: the recordings of its assignment, into this server's volume (М11, a macOS server; the
     systemd unit's twin, deploy/systemd/). `install.sh` puts @HOST@ (this host's short name) in place: launchd has
     no %l. /etc/w2c/w2c.env and /etc/vms/vms.env are read by w2c-run.sh under what this file says. The unit's
     environment, name for name (`tests/test_units.py`): the engine's socket, WHICH BOX (@BOXID@, this Mac's
     IOPlatformUUID, `install.sh` — systemd's %m), the cluster's key. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w2c.vms.recworker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/w2c/bin/w2c-run.sh</string>
		<string>recorder</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PLATFORM_STORE</key>
		<string>configstore:///var/run/configstore/recworker.sock</string>
		<key>WORKER_NAME</key>
		<string>r-@HOST@-1</string>
		<key>OBSD_SOCKET</key>
		<string>/var/run/vms-obsd/obsd.sock</string>
		<key>BOX_ID</key>
		<string>@BOXID@</string>
		<key>UNCONFIRMED_MAX</key>
		<string>90</string>
		<key>ARCHIVE_PORT</key>
		<string>8084</string>
		<key>SECRETS_KEY</key>
		<string>/etc/w2c/secrets/platform.key</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>/var/log/w2c/com.w2c.vms.recworker.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/w2c/com.w2c.vms.recworker.log</string>
</dict>
</plist>
