  {
   "id": "ok-relay-normal",
   "note": "просьба названа целиком, value normal",
   "request": "When the Dock Door sensor goes back to normal, turn off the Dock Light relay.",
   "row": {
    "when": [
     {
      "sub": "cam",
      "kind": "io.input",
      "unit": "4",
      "match": {
       "port": 3,
       "value": "normal"
      }
     }
    ],
    "then": [
     {
      "sub": "cam",
      "action": "output",
      "unit": "4",
      "port": 4,
      "state": "open"
     }
    ]
   },
   "errors": []
  },
