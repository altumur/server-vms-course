[
 {
  "id": "apply-ok",
  "rule": "V/10.6 Н1.1, Н1.4 строка — один PUT с ifMatch; секрет — только в теле",
  "console": "stand3",
  "plan": [
   {
    "unit": "testsub2/Gate-1",
    "revision": 1,
    "changes": [
     {
      "field": "mode",
      "from": "plain",
      "to": "loud"
     },
     {
      "field": "step",
      "from": 1,
      "to": 5
     }
    ]
   },
   {
    "unit": "testsub2/Office-2",
    "revision": 1,
    "changes": [
     {
      "field": "feed_secret",
      "from": "***",
      "to": {
       "secret": 1
      }
     }
    ]
   }
  ],
  "secrets": {
   "1": "<secret 1>"
  },
  "responses": [
   {
    "status": 200,
    "body": {
     "revision": 2
    }
   },
   {
    "status": 200,
    "body": {
     "revision": 2
    }
   }
  ],
  "expect": {
   "sent": [
    {
     "method": "PUT",
     "path": "/tallies/Gate-1",
     "body": {
      "mode": "loud",
      "step": 5
     },
     "ifMatch": 1
    },
    {
     "method": "PUT",
     "path": "/tallies/Office-2",
     "body": {
      "feed_secret": "<secret 1>"
     },
     "ifMatch": 1
    }
   ],
   "outcomes": {
    "testsub2/Gate-1": {
     "outcome": "applied",
     "revision": 2
    },
    "testsub2/Office-2": {
     "outcome": "applied",
     "revision": 2
    }
   }
  }
 },
