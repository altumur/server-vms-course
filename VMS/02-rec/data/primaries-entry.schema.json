{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "value of an element of the book domain/rec/primaries/*/<section>, the keys are the same at the holder and at the copy, V/02.9 N1.6; the fields «empty, false, none» are absent, except running",
 "type": "object",
 "properties": {
  "ref": {
   "type": "string",
   "minLength": 1
  },
  "recording": {
   "type": "string",
   "minLength": 1
  },
  "running": {
   "type": "boolean"
  },
  "role": {
   "enum": [
    "primary",
    "backup"
   ]
  },
  "when": {
   "const": "offline"
  },
  "retention_days": {
   "type": "number",
   "minimum": 0
  },
  "home": {
   "type": "string",
   "minLength": 1
  },
  "server": {
   "type": "string",
   "minLength": 1
  },
  "push": {
   "const": true
  },
  "since": {
   "type": "number",
   "x-time": true
  },
  "as_of": {
   "type": "number",
   "x-time": true
  }
 },
 "required": [
  "ref",
  "recording",
  "running",
  "role",
  "retention_days",
  "as_of"
 ],
 "additionalProperties": false
}
