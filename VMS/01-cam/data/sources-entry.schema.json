{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "элемент вклада cam/sources/<слот> и value элемента книги domain/cam/sources (V/01.6 Н1.2): размещённая камера или камера опроса; поля без значения опускаются, \"\" и null не бывает",
 "type": "object",
 "properties": {
  "ref": {
   "type": "string",
   "minLength": 1
  },
  "to": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "live_url": {
   "type": "string",
   "pattern": "^(?:rtsp://[\\s\\S]*)$"
  },
  "codec": {
   "type": "string",
   "minLength": 1
  },
  "server": {
   "type": "string",
   "minLength": 1
  },
  "as_of": {
   "type": "number",
   "x-time": true
  },
  "push": {
   "const": true
  },
  "polls": {
   "const": true
  }
 },
 "required": [
  "ref",
  "to",
  "as_of"
 ],
 "additionalProperties": false
}
