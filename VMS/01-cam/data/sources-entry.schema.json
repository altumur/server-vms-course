{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "value of an element of the book domain/cam/sources (the copy at a member) and domain/cam/sources/<member> (at the domain holder), V/01.6 Н1.2: a placed camera or a polled camera; fields without a value are omitted, \"\" and null never occur",
 "type": "object",
 "properties": {
  "ref": {
   "type": "string",
   "minLength": 1
  },
  "to": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "live_url": {
   "type": "string",
   "pattern": "^(?:rtsp://[\\s\\S]*)$"
  },
  "codec": {
   "type": "string",
   "minLength": 1
  },
  "server": {
   "type": "string",
   "minLength": 1
  },
  "as_of": {
   "type": "number",
   "x-time": true
  },
  "push": {
   "const": true
  },
  "polls": {
   "const": true
  }
 },
 "required": [
  "ref",
  "to",
  "as_of"
 ],
 "additionalProperties": false
}
