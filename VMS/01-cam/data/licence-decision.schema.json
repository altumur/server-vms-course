{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "the licence decision of a member — value of an element of the row of the carried book domain/cam/licence/<member> (V/01.7 N1.2 «book»)",
 "type": "object",
 "properties": {
  "state": {
   "type": "string",
   "enum": [
    "valid",
    "grace",
    "degraded",
    "invalid"
   ]
  },
  "units": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  },
  "as_of": {
   "type": "number",
   "x-time": true
  },
  "until": {
   "type": "number",
   "x-time": true
  },
  "licensed": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  }
 },
 "required": [
  "state",
  "units",
  "as_of",
  "licensed"
 ],
 "additionalProperties": false
}
