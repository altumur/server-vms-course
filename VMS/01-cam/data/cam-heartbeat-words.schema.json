{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "the words of the subsystem cam in the heartbeat cam/heartbeats/<name> — open places of the Platform family heartbeats (P/03.4 N1.1: an element of status[] beyond the Platform fields, the top of the heartbeat beyond the Platform fields); the meaning — V/01.2 N1.4, V/01.4, V/01.5, V/01.6",
 "type": "object",
 "properties": {
  "status": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "phase": {
      "description": "a cam word (V/01.2 N1.4) or a Platform phase sealed, unreadable (P/03.4)",
      "type": "string",
      "enum": [
       "running",
       "idle",
       "pending",
       "held",
       "failed",
       "unlicensed",
       "sealed",
       "unreadable"
      ]
     },
     "live_url": {
      "description": "the RTSP of the delivery on loopback; only with running and type camera (V/01.2 N1.3)",
      "type": "string",
      "pattern": "^(?:rtsp://[\\s\\S]*)$"
     },
     "live_shm": {
      "description": "the frame share of its own epoch, the absolute path shm:///…/<id>-<epoch>.shm (V/01.2 N1.3)",
      "type": "string",
      "pattern": "^(?:shm:///[\\s\\S]*)$"
     },
     "type": {
      "description": "only for a row that is not camera (V/01.2 N1.4)",
      "type": "string",
      "enum": [
       "ipsrv",
       "eventsrc",
       "acfa"
      ]
     },
     "size": {
      "description": "<width>x<height> of the stream frame (V/01.2 N1.4)",
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*x[1-9][0-9]*)$"
     },
     "codec": {
      "description": "the stream codec by the first frames, the rtpmap name; only with running and type camera, another codec — no field (V/01.2 N1.4)",
      "type": "string",
      "enum": [
       "H264",
       "H265"
      ]
     },
     "device_state": {
      "type": "string",
      "enum": [
       "busy",
       "refused",
       "opening",
       "lost"
      ]
     },
     "units_down": {
      "description": "the units of the row that do not work (V/01.2 N1.4, V/01.4 N1.4b): the key is n",
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "enum": [
        "lost",
        "failed",
        "refused"
       ]
      }
     },
     "warning": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "can": {
      "description": "the capabilities of the camera device (V/01.4 N1.4)",
      "type": "object"
     },
     "playback_url": {
      "type": "string"
     },
     "coverage": {
      "description": "the coverage of the device archive (V/01.5 N1.1)",
      "type": "object",
      "properties": {
       "from": {
        "type": "number",
        "x-time": true
       },
       "to": {
        "type": "number",
        "x-time": true
       },
       "fragments": {
        "type": "integer",
        "minimum": 0,
        "x-integer": true
       },
       "said_at": {
        "type": "number",
        "x-time": true
       }
      },
      "required": [
       "from",
       "to",
       "fragments"
      ],
      "additionalProperties": false
     },
     "index_url": {
      "type": "string"
     },
     "talk": {
       "description": "talk at the host row with a live, not disabled spk: the url of the holder's door and the codec of each number, the rtpmap name (V/01.2 N1.4, V/01.4 N1.4a)",
       "type": "object",
       "properties": {
         "url": {
           "type": "string",
           "minLength": 1
         },
         "spk": {
           "type": "object",
           "minProperties": 1,
           "additionalProperties": {
             "type": "string",
             "minLength": 1
           }
         }
       },
       "required": [
         "url",
         "spk"
       ],
       "additionalProperties": false
     },
     "taken_by": {
      "description": "who takes the camera stream: a list of cluster names (V/01.6 N1.4)",
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "additionalProperties": true
   }
  },
  "devices": {
   "description": "per device of the group — an element of GET /devices of the holder's door (V/01.5 N1.4)",
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "devices_slow": {
   "type": "integer",
   "minimum": 1,
   "x-integer": true
  },
  "door_reads_stuck": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  },
  "devices_opening": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  },
  "identity_changes": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  },
  "events_refused": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  },
  "inputs_off": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  },
  "identity_coincidences": {
   "type": "integer",
   "minimum": 0,
   "x-integer": true
  }
 },
 "additionalProperties": true
}
