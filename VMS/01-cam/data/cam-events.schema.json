{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "слова подсистемы cam в строке события бакета камеры (открытое место семьи платформы events-unit — корень строки, поля сверх t, kind, id, of, class, occurred, v); тип поля задаёт пишущий урок — V/01.2 Н1.5; читают консоль (/events, P/06.4 — как есть) и сценарии auto (V/07.2 Н1.3 — строго)",
 "type": "object",
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "io.input"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "port": {
      "type": "integer",
      "minimum": 1,
      "x-integer": true,
      "description": "вход устройства в нумерации V/01.4 Н1.1, с 1"
     },
     "value": {
      "type": "string",
      "enum": [
       "open",
       "closed"
      ],
      "description": "closed — начало тревоги, open — конец: от norm входа (V/01.4 Н1.4а)"
     }
    },
    "required": [
     "port",
     "value"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "source-stats"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "dropped": {
      "type": "integer",
      "minimum": 0,
      "x-integer": true,
      "description": "кадров отброшено за окно сводки"
     },
     "depth": {
      "type": "integer",
      "minimum": 0,
      "x-integer": true,
      "description": "глубина очереди источника"
     }
    },
    "required": [
     "dropped",
     "depth"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "text"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "lines": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "rawData строки EventData источника текста"
     },
     "group": {
      "type": "integer",
      "minimum": 1,
      "x-integer": true,
      "description": "номер группы в пределах соединения; вне группы поля нет"
     },
     "camera": {
      "type": "string",
      "description": "поле camera строки eventsrc (V/01.1 Н1.1г)"
     },
     "word": {
      "type": "string",
      "minLength": 1,
      "description": "msg первого совпавшего элемента words (V/01.2 Н1.5)"
     }
    },
    "required": [
     "lines"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "unit"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "properties": {
     "unit": {
      "type": "string",
      "description": "id строки cam/device_units"
     },
     "event": {
      "type": "string",
      "minLength": 1,
      "description": "слово шаблона единицы как есть"
     },
     "phase": {
      "type": "string",
      "enum": [
       "begin",
       "end",
       "still"
      ],
      "description": "у двухфазного события: still — фаза открыта, повтор держателя; у мгновенного поля нет"
     },
     "det_kind": {
      "type": "string",
      "minLength": 1,
      "description": "у встроенного детектора: вид по detector-kinds.tsv, вне таблицы other"
     }
    },
    "required": [
     "unit",
     "event"
    ]
   }
  }
 ],
 "additionalProperties": true
}