{
  "description": "Frictionless Table Schema of Platform/01-store/forms/stages.kit.tsv (ADR-0125 addenda (12), (13); OBSH.39.1). Every field is a raw string: no type coercion. Lexical constraints only where the header of the form states them; the rules this schema does not express stay with the existing checks (raw map of the change 0125-forms-standard-schemas).",
  "fields": [
    {
      "name": "n",
      "type": "string",
      "constraints": {
        "required": true,
        "pattern": "(?:[1-9][0-9]*)"
      }
    },
    {
      "name": "stage",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "goal",
      "type": "string"
    },
    {
      "name": "norms",
      "type": "string"
    },
    {
      "name": "gate",
      "type": "string",
      "constraints": {
        "required": true,
        "pattern": "(?:(?:tests:[0-9]+(?:\\.[0-9]+)?:[^:;\\s]+(?::seams)?|accept:[0-9]+(?:\\.[0-9]+)?:[^:;\\s]+|vectors:(?:(?:common|[0-9]{2}-[a-z0-9-]+)/)?[a-z0-9-]+|build)(?:;(?:tests:[0-9]+(?:\\.[0-9]+)?:[^:;\\s]+(?::seams)?|accept:[0-9]+(?:\\.[0-9]+)?:[^:;\\s]+|vectors:(?:(?:common|[0-9]{2}-[a-z0-9-]+)/)?[a-z0-9-]+|build))*)"
      }
    },
    {
      "name": "weight",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ]
      }
    },
    {
      "name": "kit",
      "type": "string",
      "constraints": {
        "required": true,
        "pattern": "(?:-|(?:writecheck|door|flags|refusals|vectors|stagetests|launch)(?:,(?:writecheck|door|flags|refusals|vectors|stagetests|launch))*)"
      }
    },
    {
      "name": "parts",
      "type": "string",
      "constraints": {
        "required": true,
        "pattern": "(?:-|(?:writecheck|door|flags|refusals|vectors|stagetests|launch)(?:,(?:writecheck|door|flags|refusals|vectors|stagetests|launch))*)"
      }
    },
    {
      "name": "depends",
      "type": "string",
      "constraints": {
        "required": true,
        "pattern": "(?:-|[1-9][0-9]*(?:,[1-9][0-9]*)*)"
      }
    },
    {
      "name": "when",
      "type": "string",
      "description": "CEL over the keys of the profile, empty: always applicable; checked by the existing CEL guard."
    }
  ]
}
