{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "rev": {
   "description": "{term, rev} of the folders copy at the member; no copy — null",
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "term": {
     "type": "integer",
     "minimum": 0
    },
    "rev": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false,
   "required": [
    "term",
    "rev"
   ]
  },
  "scope": {
   "description": "what to hold: the whole tree or the chains of its own units",
   "type": "string",
   "enum": [
    "all",
    "chains"
   ]
  },
  "gone": {
   "description": "the membership rows whose unit is removed",
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "own": {
   "description": "the folders of the cluster before joining the domain",
   "type": "object",
   "properties": {
    "folders": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^(?:[0-9a-f]{32})$"
       },
       "name": {
        "type": "string"
       },
       "parent": {
        "type": "string"
       }
      },
      "additionalProperties": false,
      "required": [
       "id",
       "name",
       "parent"
      ]
     }
    },
    "memberof": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "folders",
    "memberof"
   ]
  }
 },
 "additionalProperties": false,
 "required": [
  "rev",
  "scope",
  "gone"
 ]
}
