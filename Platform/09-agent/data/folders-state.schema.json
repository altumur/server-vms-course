{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "rev": {
   "description": "rev копии папок у члена; копии нет — 0",
   "type": "integer",
   "minimum": 0
  },
  "scope": {
   "description": "что держать: всё дерево или цепочки своих единиц",
   "type": "string",
   "enum": [
    "all",
    "chains"
   ]
  },
  "gone": {
   "description": "строки членства, чья единица снята",
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "own": {
   "description": "папки кластера до входа в домен",
   "type": "object",
   "x-opaque": true
  }
 },
 "additionalProperties": false,
 "required": [
  "rev",
  "scope",
  "gone"
 ]
}
