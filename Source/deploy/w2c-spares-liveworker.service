# /etc/systemd/system/w2c-spares-liveworker.service — the one-shot its timer fires: spare live gateways
# (`w2c-spares.sh liveworker`), for the label sets this server covers, as many as `live_workers_needed on /live/metrics` says and
# `MAX_GATEWAYS` allows. Each is `systemctl start vms-liveworker-spare@<n>` — its role's unit's template, the same user, groups and key —
# with `SPARE_FOR=<set>` in its one-line file: it takes an offer of its set, or waits holding nothing. Nothing is ever stopped. Why a host unit and not a container:
# `w2c-spares.service`.
[Unit]
Description=w2c: start spare live gateways the console says are missing
After=network-online.target

[Service]
Type=oneshot
# NOT ROOT (the product's cross-check, 4 Oct): its own user, in no group but its own — polkit lets `w2c-spares` do one thing,
# `start`, of the spares' templates and nothing else (М11's `w2c-spares.rules`, its user in `w2c-cluster.sysusers`,
# both installed by its `install.sh --spares`); it opens no store and reads no key.
User=w2c-spares
Group=w2c-spares
ExecStart=/usr/local/bin/w2c-spares.sh liveworker
EnvironmentFile=-/etc/w2c/w2c.env
EnvironmentFile=-/etc/vms/vms.env
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Where it writes each spare's label set for the spare's template to read (`$SPARES_ENV`): the one directory it may
# write, kept between runs — a spare restarted by systemd reads its file again.
RuntimeDirectory=w2c-spares
RuntimeDirectoryPreserve=yes
# Its user's, 0755: a spare (user `vms`) reads its own file there, and only the line `SPARE_FOR=` of it (`w2c-run.sh`).
RuntimeDirectoryMode=0755
