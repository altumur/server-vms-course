# camworker.env — the declaration of the role camworker on this host (ADR-0070, step 3): /etc/vms/roles/camworker.env (on a macOS box
# <box>/roles/camworker.env). The installation lays this example there when it finds none; edit it there.
# Read by the role's workers (w2c-run.sh, for the role its unit names, W2C_ROLE; a box's container, EnvironmentFile=)
# and by the spares pass — HOST_MEMORY_MB and WORKER_MEMORY_MB only: its ceiling on this host is
# HOST_MEMORY_MB / WORKER_MEMORY_MB, rounded down (deploy/w2c-spares.sh).

# Cameras one worker carries (its heartbeat says it to the controller): М9 Lesson 7's B + n·I, measured on ITS server.
CAPACITY=50

# A worker's budget in MiB: a worker does not start when its units, at what its spec says they cost
# (placement.capacity.unit_mb, base_mb — the product's measurement of 2026-10-11, ADR-0070), do not fit it:
# 50 cameras × 1 MB + 18 MB (cam.subsystem.yaml) = 68 MB — 128; the ceiling 512/128 = 4.
# The host's memory given to the role in MiB: as many workers of the role as fit it is the spares' ceiling.
WORKER_MEMORY_MB=128
HOST_MEMORY_MB=512
