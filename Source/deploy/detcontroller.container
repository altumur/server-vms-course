# /etc/containers/systemd/detcontroller.container — the det subsystem's
# controller: the platform's SpecController run from det.subsystem.yaml, one
# per box (one per cluster in М11), no code of its own. Places models on the
# GPU-labelled detector worker with the most stream headroom; takes them back when the console deletes
# them. No port; its token writes det/workers/*, det/placement/*, det/slots/*.
[Unit]
Description=VMS det controller — the only writer of det placement
After=network.target

[Container]
Image=localhost/vmsserver:latest
# The platform's controller from the spec `det.subsystem.yaml` (`SPEC_DIR` in the image), in the platform's loop
# (`w2cplatform/host.py`; the boundary's step 5) — no code of the VMS's runs here.
Exec=python3 -m w2cplatform controller det
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
Network=host

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
