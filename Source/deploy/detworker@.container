# /etc/containers/systemd/detworker@.container — a detector worker: the
# third subsystem's worker. `systemctl start detworker@d-1` — the instance
# name is the slot. Its unit is one model on one camera; its capacity is streams
# a GPU can decode and infer on; it runs where its labels say (NOMAD_META_labels
# or DET_LABELS=gpu in vms.env). Its events go into det/<unit>/e<epoch>/ on this
# server's resource, under the epoch it holds. Its token writes its slot, its
# epochs and its heartbeat — never a row. In М11 a service job placed by
# constraint on GPU servers, scaled on det_worker_headroom.
[Unit]
Description=VMS detector worker %i — models on GPU-labelled servers, events into the resource
After=network.target

[Container]
Image=localhost/vmsserver:latest
Exec=python3 -m vms detworker
Environment=DET_NAME=%i
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
Volume=/data/platform/events:/data/platform/events:z
# a CLIENT of the platform's events archive: `w2c-events`, by number — what it writes there the resource deletes.
GroupAdd=2102
AddDevice=/dev/dri
Network=host
StopTimeout=10

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
