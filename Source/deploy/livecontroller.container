# /etc/containers/systemd/livecontroller.container — the live subsystem's
# controller: the platform's SpecController run from live.subsystem.yaml, one
# per box (one per cluster in М11), no code of its own. Places fan-outs on the
# gateway with the most viewer headroom; takes them back when a gateway deletes
# them. No port; its token writes live/workers/*, live/placement/*, live/slots/*.
[Unit]
Description=VMS live controller — the only writer of live placement
After=network.target

[Container]
Image=localhost/vmsserver:latest
Exec=python3 -m vms livecontroller
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
Network=host

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
