# /etc/systemd/system/vms-vmscontroller.service — placement of cameras, on every server. One would do; several are
# safe, because every write is a CAS (lesson 10) — and with one on every server none has to be moved anywhere. It
# never starts a process: it publishes numbers and offers (`<sub>/slots/<w-N>` with `offer`), and `w2c-spares.sh`
# on each server does the starting.
[Unit]
Description=VMS controller — placement of cameras
After=network-online.target configstore.service w2c-resource.service
Wants=network-online.target configstore.service

[Service]
User=vms
Group=vms
# Its store socket's group, and the objects' (WP-E): the snapshot it publishes is objects on this server.
SupplementaryGroups=vms-vmscontroller w2c-store
Environment=PLATFORM_STORE=configstore:///run/configstore/vmscontroller.sock
# /etc/w2c/w2c.env, then /etc/vms/vms.env: read by w2c-run.sh UNDER what this unit says — `EnvironmentFile=` would
# override `Environment=` (systemd's rule), and the socket and the name above are the unit's, never a file's.
UMask=0007
ExecStart=/opt/w2c/bin/w2c-run.sh controller
Restart=always
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/platform/objects
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
