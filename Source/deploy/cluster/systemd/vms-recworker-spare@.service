# /etc/systemd/system/vms-recworker-spare@.service — a SPARE recorder, started by `w2c-spares.sh` as
# `vms-recworker-spare@<n>` for a declared volume nobody holds (lesson 4). The recorder's unit, line for line — the
# same user, groups, socket, engine, box, key, umask, watchdog — but no name (it claims whichever `r-<n>` is free and
# takes a free volume by CAS: a recorder needs no offer) and its door on a port the OS gives. It ran from
# `systemd-run` as root before, without the key (the twelfth review, blocker 6): a network volume's sealed secret
# did not open. `tests/cluster/test_units.py` holds this file to `vms-recworker.service`.
[Unit]
Description=VMS spare recorder %i — takes a declared volume nobody holds
After=network-online.target configstore.service w2c-resource.service vms-obsd.service
Wants=network-online.target
# The store's member and the archive's engine must be UP already, not pulled up (the thirteenth review, major 12):
# `Wants=` started a stopped engine whenever the spares' timer started a spare — the administrator stops it to hand
# the volumes over (`install-obsd.sh`, `chown -R`), and PID 1 brought it back under the chown, past polkit, which lets
# the spares' user start this template and nothing else. Either not running: this spare does not start.
Requisite=configstore.service vms-obsd.service

[Service]
User=vms
Group=vms
SupplementaryGroups=vms-recworker vms-obsd w2c-events w2c-store w2c-secrets
Environment=PLATFORM_STORE=configstore:///run/configstore/recworker.sock
Environment=OBSD_SOCKET=/run/vms-obsd/obsd.sock
Environment=BOX_ID=%m
Environment=UNCONFIRMED_MAX=90
# A second recorder on this server: its door on a port the OS gives, published in its heartbeat on the address
# `ARCHIVE_URL` names — 8084 is the server's own recorder's.
Environment=ARCHIVE_PORT=0
LoadCredential=platform.key:/etc/w2c/secrets/platform.key
Environment=SECRETS_KEY=%d/platform.key
UMask=0007
Type=simple
NotifyAccess=main
ExecStart=/opt/w2c/bin/w2c-run.sh recorder
Restart=always
RestartSec=2
TimeoutStopSec=40
WatchdogSec=360
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/platform/events /data/platform/objects
ProtectHome=yes
PrivateTmp=yes
