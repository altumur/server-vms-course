# /etc/w2c/w2c.env — the PLATFORM's settings of this server (the product's split: the subsystem's are in
# /etc/vms/vms.env). Read by `w2c-run.sh` under what each unit says; `install.sh` writes it from this example.
# A line is NAME=value; nothing here is run.
#
# No PLATFORM_STORE here: on a cluster each unit names its own role's socket
# (`configstore:///run/configstore/<role>.sock`), and a process with none opens its verb's role's socket.

# This server, as the cluster knows it: the name in every heartbeat and every URL it publishes, and what it reaches.
SERVER_NAME=srv-a
LABELS=vlan:cctv-a
# Where the platform's state lives on this server: the store's journal, the objects of `cluster://`.
PLATFORM_DIR=/data/platform
# The platform's events archive on this server (the box's layout): the resource's tree — every subsystem's events, and
# where every process that holds a slot registers (`Worker.present`). Its clients join `w2c-events`.
RESOURCE_ROOT=/data/platform/events
# The cluster's objects: this server's as files, every server's through the resource here.
OBJECTS=cluster:///data/platform/objects?resource=http://127.0.0.1:8090
# How the console and the other resources reach this server's resource — an address, no DNS between servers.
RESOURCE_URL=http://10.0.0.1:8090

# The store: this server's member of the raft group.
CONFIGSTORE_RAFT=10.0.0.1:8301
CONFIGSTORE_API=10.0.0.1:8300
# Empty on the cluster's first server (`-bootstrap`: a group of one); on every other, a member's door:
#CONFIGSTORE_JOIN=srv-a@10.0.0.1:8300
# The voters the group is declared to have: 1, 3 or 5, the same on every server (ADR-0070). A join that makes the group
# even, or larger than this, is refused unless it says -force — the second of three does (`CONFIGSTORE_FLAGS=-force`
# on that server, or `configstore join -force …`). /metrics: configstore_raft_voters against …_voters_expected.
CONFIGSTORE_GROUP_SIZE=3
#CONFIGSTORE_FLAGS=-force
CONFIGSTORE_TUNING=lan
# The installation's CA and this server's certificate (`deploy/w2c-ca.sh issue <server> configstore`).
W2C_TLS=/etc/w2c/tls

# The spares (`w2c-spares.sh`, from `install.sh --spares`): where it asks for the numbers. How many it may start is each
# role's declaration's (`roles/<role>.env` beside the subsystem's file: HOST_MEMORY_MB / WORKER_MEMORY_MB, ADR-0070); what a spare runs is
# its role's template, `vms-<role>-spare@.service` — nothing said here.
CONSOLE=http://127.0.0.1:8080
# The consoles' origins a page may come from, comma-separated — the holders' page doors answer them (CORS; `door.py`). The
# door key itself is in the store (`door/signer`, `door/keys`): the console makes it, `python3 -m w2cplatform.door new`
# rotates it.
#DOOR_ORIGINS=http://srv-a:8080,http://srv-b:8080,http://srv-c:8080
