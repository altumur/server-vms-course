<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/com.w2c.console.plist — the platform's console: the page and the API (М11, a macOS server; the
     systemd unit's twin, deploy/cluster/systemd/). `install.sh` puts @HOST@ (this host's short name) in place: launchd has
     no %l. __BOX__/w2c.env and __BOX__/vms.env are read by w2c-run.sh under what this file says (`W2C_BOX`). The unit's
     environment, name for name (`tests/cluster/test_units.py`): the box's own door, and the cluster's key — read where it
     lies, launchd having no credentials directory; without it the console stored passwords in the clear. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w2c.console</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BOX__/bin/w2c-run.sh</string>
		<string>console</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>W2C_BOX</key>
		<string>__BOX__</string>
		<key>PLATFORM_STORE</key>
		<string>configstore://__BOX__/state/run/configstore/console.sock</string>
		<key>CONSOLE_PORT</key>
		<string>8080</string>
		<key>CONSOLE_ROOT</key>
		<string>vms</string>
		<key>CONSOLE_UNIX</key>
		<string>__BOX__/state/run/w2c-console/console.sock</string>
		<key>SECRETS_KEY</key>
		<string>__BOX__/secrets/platform.key</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>__BOX__/state/logs/com.w2c.console.log</string>
	<key>StandardOutPath</key>
	<string>__BOX__/state/logs/com.w2c.console.log</string>
</dict>
</plist>
