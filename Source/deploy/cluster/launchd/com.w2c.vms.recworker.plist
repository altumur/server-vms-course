<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/com.w2c.vms.recworker.plist — the recorder: the recordings of its assignment, into this server's volume (М11, a macOS server; the
     systemd unit's twin, deploy/cluster/systemd/). `install.sh` puts @HOST@ (this host's short name) in place: launchd has
     no %l. __BOX__/w2c.env and __BOX__/vms.env are read by w2c-run.sh under what this file says (`W2C_BOX`). The unit's
     environment, name for name (`tests/cluster/test_units.py`): the engine's socket, WHICH BOX (@BOXID@, this Mac's
     IOPlatformUUID, `install.sh` — systemd's %m), the cluster's key. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w2c.vms.recworker</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BOX__/bin/w2c-run.sh</string>
		<string>vms</string>
		<string>recorder</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>W2C_BOX</key>
		<string>__BOX__</string>
		<key>PLATFORM_STORE</key>
		<string>configstore://__BOX__/state/run/configstore/recworker.sock</string>
		<key>WORKER_NAME</key>
		<string>r-@HOST@-1</string>
		<key>OBSD_SOCKET</key>
		<string>__BOX__/state/run/vms-obsd/obsd.sock</string>
		<key>BOX_ID</key>
		<string>@BOXID@</string>
		<key>ARCHIVE_PORT</key>
		<string>8084</string>
		<key>SECRETS_KEY</key>
		<string>__BOX__/secrets/platform.key</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>__BOX__/state/logs/com.w2c.vms.recworker.log</string>
	<key>StandardOutPath</key>
	<string>__BOX__/state/logs/com.w2c.vms.recworker.log</string>
</dict>
</plist>
