<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/com.w2c.configstore.plist — this server's member of the cluster's replicated config store, a socket per role (М11, a macOS server; the
     systemd unit's twin, deploy/cluster/systemd/). `install.sh` puts @HOST@ (this host's short name) in place: launchd has
     no %l. __BOX__/w2c.env and __BOX__/vms.env are read by w2c-run.sh under what this file says (`W2C_BOX`). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.w2c.configstore</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BOX__/bin/w2c-run.sh</string>
		<string>configstore</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>W2C_BOX</key>
		<string>__BOX__</string>
		<key>CONFIGSTORE_SOCKETS</key>
		<string>__BOX__/state/run/configstore</string>
	</dict>
	<!-- Its journal is its own (r28-ops2): 0077, as the unit's UMask; `w2c-run.sh` sets the same. -->
	<key>Umask</key>
	<integer>63</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>__BOX__/state/logs/com.w2c.configstore.log</string>
	<key>StandardOutPath</key>
	<string>__BOX__/state/logs/com.w2c.configstore.log</string>
</dict>
</plist>
