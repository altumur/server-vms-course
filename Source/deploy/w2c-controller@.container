# /etc/containers/systemd/w2c-controller@.container — a subsystem's controller, the platform's process from the
# subsystem's spec: one instance per subsystem the image carries (`w2c-controller@vms`, `@rec`, `@live`, `@det`,
# `@detjob`, `@survey`, `@auto`), one per box (one per cluster in М11). Stateless — restart it freely. No port: nothing
# asks it anything. Its token writes its subsystem's placement only — `<sub>/workers/*`, `<sub>/placement/*`,
# `<sub>/slots/*`, the snapshot — and never an operator's row.
# ================================================================================================
# NOTES — what every part of this file does and why (kept beside the code, not in a separate document)
# ================================================================================================
# # w2c-controller@.container — a subsystem's controller: the platform's, one instance per spec, stateless, no port
#
# **Role.** The Quadlet template at `/etc/containers/systemd/w2c-controller@.container`; Quadlet generates
# `w2c-controller@.service` from it, and the instance names the subsystem (`systemctl start w2c-controller@vms`). It
# runs `python3 -m w2cplatform controller %i` — the platform's `SpecController` from `%i.subsystem.yaml` alone (the
# boundary's steps 5 and 6: no subsystem's code runs here): the placement pass every five seconds — `ensure_placed`,
# `redistribute`, `publish_snapshot`. A platform process, so the platform's name and user (ADR 0023): `w2c`, by
# number, never the subsystem's. Stateless, restart it freely; nothing asks it anything, so no port. Its token
# writes placement only (`SPEC.acl_controller()`) and the snapshot object — and never an operator's row. Its journal —
# a slot it frees and why, `units.left_on_leaving` — goes into the events archive (`host.controller_loop`, by
# `RESOURCE_ROOT` from `w2c.env`), so the archive is mounted. Checked by `tests/test_deploy_units.py`.
#
# - `Description=w2c controller — the only writer of placement of %i`
#
# - `RestartSec=2`.
#
# ## Notes
# - No `count` and no scheduler client: how many workers exist is systemd's (`vmsworker@…` instances) or
#   Nomad's; the controller only reads their heartbeats and the `released` flag on slots.
# - Two of these running against one store are harmless (`test_two_controllers_agree_by_cas`), so a restart
#   overlapping an old instance needs no lock.
# ================================================================================================
[Unit]
Description=w2c controller — the only writer of placement of %i
# ordering only.
After=network.target

[Container]
# the shared image.
Image=localhost/vmsserver:latest
# the platform's `controller <sub>` (`w2cplatform/host.py`): `SpecController` over the spec `SPEC_DIR` holds for the
# instance's subsystem, a store opened as writer `<sub>controller` with the controller ACL.
Exec=python3 -m w2cplatform controller %i
# the platform's user and its primary group, by number: the container has no /etc/passwd of the host's.
User=2100
Group=2100
# it needs `PLATFORM_DIR` (the stores), `RESOURCE_ROOT` (where its journal goes) and `LOG_LEVEL`; the rest of the
# files is harmless to it.
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# the config store for rows, assignments, placement, slots and the object store for heartbeats (read) and the
# snapshot (write): the platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring):
# setgid `w2c-store`, joined by number — the workers' heartbeats are theirs, 0660 to the group; every file this
# process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
# …and the events archive, for its journal alone: "the ACL says which rows each token writes; the mounts say which
# bytes". Its lines lay in the container's own layer, where nobody reads them, while it was not mounted. A client of
# the archive like every writer there — `w2c-events`, by number: the directories other clients made are 2770 to it.
Volume=/data/platform/events:/data/platform/events:z
GroupAdd=2102
# nothing listens; kept for symmetry and for М11's stores.
Network=host

[Service]
# a crash loses nothing: every pass reads the store, decides, writes by CAS. Recording continues while it is
# down (`test_the_failure_arithmetic`; "the controller is never on the recovery path").
Restart=always
RestartSec=2

[Install]
# enabled instances start at boot (`systemctl enable w2c-controller@vms`), one for every spec of the image.
WantedBy=multi-user.target
