# /etc/containers/systemd/vmsworker@.container — the worker, on М9's box.
# `systemctl start vmsworker@w-1` — the instance name is the slot the worker
# claims (М10 Lesson 4). One instance on one box; in М11 this unit becomes
# vmsworker.nomad.hcl with count = N and the slot from NOMAD_ALLOC_INDEX.
# М9's worker.container, with Postgres gone: the worker's truth is the
# platform's stores on the data partition, and its archive is the resource.
# ================================================================================================
# NOTES — what every part of this file does and why (kept beside the code, not in a separate document)
# ================================================================================================
# # vmsworker@.container — the worker as a Quadlet template: `systemctl start vmsworker@w-1`, the instance
# name is the slot
#
# **Role.** The Podman Quadlet unit for `vmsworker` on М9's box, installed at
# `/etc/containers/systemd/vmsworker@.container`; Quadlet generates `vmsworker@.service` from it. A
# template: the instance name after `@` (`%i`) is the slot the worker claims (М10 Lesson 4), so
# `vmsworker@w-1` and `vmsworker@w-2` are two workers with stable names. It is М9's `worker.container` with
# Postgres gone — the worker's truth is the platform's stores on the data partition and its archive is the
# resource. In М11 this unit becomes `vmsworker.nomad.hcl` with `count = N` and the slot from
# `NOMAD_ALLOC_INDEX`. Checked by `tests/test_deploy_units.py` (image, `Exec`, env file, `/data/` volumes,
# the archive writable, media read-only, `StopTimeout=20`) and by `check-quadlet.sh` on a box with podman.
#
# ## Notes
# - One instance per box is the course's setting; nothing forbids `vmsworker@w-2` on the same box — that is
#   how "the zombie on one box" is reproduced by hand with two real processes (start `w-1` twice under
#   different unit names, or pause one).
# - What differs from the controller and console units is exactly the mounts: only this unit has
#   `/data/media`.
# ================================================================================================
[Unit]
# `%i` is substituted per instance in `systemctl status`.
Description=VMS worker %i — holds its cameras: DriverPack, the fan-out, the events
# ordering only; the worker needs no network on one box (file stores), but the console's port and М11's
# stores will.
After=network.target

[Container]
# the one image the Containerfile builds; the test asserts all four units name it.
Image=localhost/vmsserver:latest
# the `worker` verb of `vms/__main__.py` (also the image's default `CMD`, repeated so the unit reads on its
# own).
Exec=python3 -m vms worker
# the slot preference: `__main__.worker` reads `WORKER_NAME` and `VmsWorker.claim_slot(prefer=…)` takes
# exactly that slot by CAS, even from a holder that has not lapsed — systemd is the authority on which
# process is the current `w-1`, and the old one finds out at its next `renew_slot` and fences.
Environment=WORKER_NAME=%i
# `PLATFORM_DIR`, `RESOURCE_ROOT` (`w2c.env.example`), `MEDIA_DIR`, `CAPACITY`, `LOG_LEVEL` (`vms.env.example`):
# `/etc/w2c` and `/etc/vms` are links into the data partition, never a rootfs slot.
# The worker's TWO doors, and neither may be a constant in a template: the RTSP fan-out and the playback
# surface. A second `vmsworker@w-2` on the same box is the ordinary way to use capacity (the autoscaler
# does exactly that), and a fixed 8554 turns it into a crash loop. `auto` asks the OS; both addresses are
# published per camera in the heartbeat (`live_url`, `playback_url`) and read from there by the recorder,
# the gateway, the detectors and the console — which is what the heartbeat has been for since Lesson 4.
Environment=RTSP_PORT=auto
Environment=PLAYBACK_PORT=auto
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# the two stores, read-write: the worker writes `vms/epoch/*`, `vms/slots/*`, `vms/devices/*` (its token) and its heartbeat
# object. `:z` relabels for SELinux, shared.
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
# The cluster's key (`w2cplatform/sealing.py`): the console seals device passwords with it, the holder opens
# them for the pipeline (and the recorder a network volume's secret). Mounted, as one file, into those units ONLY —
# never inside a store, where it would be copied with every copy of it; `/etc/w2c/secrets` (a link into
# /data/platform/etc) is mounted nowhere else, and no unit mounts /data/platform whole.
# `python3 -m w2cplatform.sealing new /etc/w2c/secrets/platform.key`.
Volume=/etc/w2c/secrets/platform.key:/run/secrets/platform.key:ro,z
# the key ring is 0640, group `w2c-secrets`: a process that seals or opens a secret joins it, by number.
GroupAdd=2104
Environment=SECRETS_KEY=/run/secrets/platform.key
# the worker records nothing — the recorder does (`recworker@.container`). Read-write here
# because the camera's event buckets, `vms/<cam>/e<epoch>/`, are the worker's, on this server's resource;
# it never writes under `rec/`.
Volume=/data/platform/events:/data/platform/events:z
# a CLIENT of the platform's events archive: `w2c-events`, by number — what it writes there the resource deletes.
GroupAdd=2102
# the files `driverpack://file/<name>` plays; read-only, the worker never writes media.
Volume=/data/media:/data/media:ro,z
# the tee's shared-memory branch: `shmsink` opens <SHM_DIR>/<cam>.shm here (`live_shm` in the heartbeat); a
# subscriber on THIS box — the recorder — reads it with `shmsrc`, no RTSP hop. A socket on a tmpfs, not state:
# the one mount outside /data, and nothing an update must keep. NOT the archive daemon's socket: the holder
# records nothing and reads no footage, and this is the process with a vendor's DriverPack in it — obsd's socket
# is in /run/vms-obsd, which only the recorder mounts (the review's third pass).
Volume=/run/vms:/run/vms:z
# host network: the RTSP fan-out listens on :8554 (`live_url` in the heartbeat) — what the recorder, the
# gateways and the detectors subscribe to, from this box or another server.
Network=host
# SIGTERM lets the pipelines end (EOS before NULL) and the worker release
# its slot; SIGKILL leaves the slot to lapse (Lesson 4). The worker records
# nothing, so there is no footage to lose either way.
# the comment says why: SIGTERM lets the pipelines end (the actuator sends EOS before NULL) and the worker
# `release_slot()`; SIGKILL after 20 s leaves the slot to lapse (Lesson 4) — a crash, which the controller
# does not redistribute.
StopTimeout=20

[Service]
# the process supervises its pipelines; systemd supervises the process. A restarted instance claims the same
# `%i` slot and records from its assignment with the next epoch per camera — no controller involved.
Restart=always
# two seconds between exit and restart; the failover a fresh instance measures (`previous_hb` → `started`)
# includes this.
RestartSec=2

[Install]
# enabled instances start at boot (`systemctl enable vmsworker@w-1`).
WantedBy=multi-user.target
