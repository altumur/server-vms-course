# /etc/systemd/system/w2c-spares-vmsworker.service — the one-shot its timer fires: spare camera workers
# (`w2c-spares.sh vmsworker`), for the label sets this server covers, as many as `vms_workers_needed on /metrics` says and
# `MAX_WORKERS` allows. Each is `systemctl start vms-vmsworker-spare@<n>` — its role's unit's template, the same user, groups and key —
# with `SPARE_FOR=<set>` in its one-line file: it takes an offer of its set, or waits holding nothing. Nothing is ever stopped. Why a host unit and not a container:
# `w2c-spares.service`.
[Unit]
Description=w2c: start spare camera workers the console says are missing
After=network-online.target

[Service]
Type=oneshot
# NOT ROOT (the product's cross-check, 4 Oct), and the platform's user (ADR 0030: every platform process runs as `w2c`,
# in no subsystem's group) — polkit lets `w2c` do one thing through systemd, `start`, of the spares' templates and
# nothing else (М11's `w2c-spares.rules`, installed by its `install.sh --spares`); it opens no store and reads no key.
User=w2c
Group=w2c
ExecStart=/usr/local/bin/w2c-spares.sh vmsworker
EnvironmentFile=-/etc/w2c/w2c.env
EnvironmentFile=-/etc/vms/vms.env
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Where it writes each spare's label set for the spare's template to read (`$SPARES_ENV`): the one directory it may
# write, kept between runs — a spare restarted by systemd reads its file again.
RuntimeDirectory=w2c-spares
RuntimeDirectoryPreserve=yes
# Its user's, 0755: a spare (user `vms`) reads its own file there, and only the line `SPARE_FOR=` of it (`w2c-run.sh`).
RuntimeDirectoryMode=0755
