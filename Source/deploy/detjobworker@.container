# /etc/containers/systemd/detjobworker@.container — a scan worker: the fifth
# subsystem's worker. `systemctl start detjobworker@j-1` — the instance name is
# the slot. Its unit is one model over one interval of one recording, and unlike
# every other worker here its work ENDS.
#
# Same box, same GPU and the same models as detworker@ — a separate unit because
# it carries a separate BUDGET (SCAN_CAPACITY, two by default against eight
# streams): a retro-search must not be able to spend what live detection is
# running on. It reads recorded footage through the recorders' archive doors; it
# mounts the archive because it writes its events into
# detjob/<job>/e<epoch>/ and its progress into detjob/<job>/progress.jsonl beside
# them, because its token may not write the row. In М11 a service job placed by
# constraint on GPU servers, scaled on detjob_jobs_running.
[Unit]
Description=VMS scan worker %i — models over recorded intervals, on its own budget
After=network.target

[Container]
Image=localhost/vmsserver:latest
Exec=python3 -m vms detjobworker
Environment=DETJOB_NAME=%i
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
Volume=/data/platform/events:/data/platform/events:z
# a CLIENT of the platform's events archive: `w2c-events`, by number — what it writes there the resource deletes.
GroupAdd=2102
AddDevice=/dev/dri
Network=host
StopTimeout=10

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
