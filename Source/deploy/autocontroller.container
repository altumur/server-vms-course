# /etc/containers/systemd/autocontroller.container — the auto subsystem's
# controller: scenarios placed on evaluators, one per box (one per cluster in
# М11). NOT the platform's SpecController as it stands: `AutoController` adds the
# one thing the platform cannot do — refuse a scenario the evaluator could not run, at the moment the
# operator writes it. No port; its token writes auto/workers/*, auto/placement/*, auto/slots/*.
[Unit]
Description=VMS auto controller — the only writer of scenario placement
After=network.target

[Container]
Image=localhost/vmsserver:latest
Exec=python3 -m vms autocontroller
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
Network=host

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
