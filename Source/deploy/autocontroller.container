# /etc/containers/systemd/autocontroller.container — the auto subsystem's
# controller: scenarios placed on evaluators, one per box (one per cluster in
# М11). The platform's SpecController from auto.subsystem.yaml: placing is all it does, and it writes no
# scenario — refusing one the evaluator could not run is the console's, where the operator writes it
# (`AutoController` in `python3 -m vms console`). No port; its token writes auto/workers/*, auto/placement/*,
# auto/slots/*.
[Unit]
Description=VMS auto controller — the only writer of scenario placement
After=network.target

[Container]
Image=localhost/vmsserver:latest
# The platform's controller from the spec `auto.subsystem.yaml` (`SPEC_DIR` in the image), in the platform's loop
# (`w2cplatform/host.py`; the boundary's step 5) — no code of the VMS's runs here.
Exec=python3 -m w2cplatform controller auto
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
Network=host

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
