# /etc/containers/systemd/w2c-resource.container — the resource process: the
# events' tree has no controller; it has a policy pass, a heartbeat, its HTTP
# and the event index over that tree. The same process М11 runs as the
# `resource` system job on every server, so the box and the cluster have one
# architecture. It replaced vms-archive-retain.timer: the policy pass now runs
# every 600 s from the process's loop, and a oneshot could not hold a heartbeat.
# ================================================================================================
# NOTES — what every part of this file does and why (kept beside the code, not in a separate document)
# ================================================================================================
# # w2c-resource.container — the resource process: the policy pass, the heartbeat, /events from the event
# index
#
# **Role.** The Quadlet unit at `/etc/containers/systemd/w2c-resource.container`, from which Quadlet
# generates `w2c-resource.service` — the product's name (its `w2c-resource.service`; the course's unit was
# `resource.container`): the resource is the PLATFORM's process, not the VMS's, and the platform's names are
# w2c. `python3 -m w2cplatform resource` (`host.resource`) builds the platform's `Resource` over
# `/data/platform/events` — the event trees, kept by each subsystem's days less what a spec's `holds:` keeps (the
# specs of the image's `SPEC_DIR`) — serves the platform's HTTP on
# `127.0.0.1:8090` (`/buckets`, `/events`, `/mirrored`, `PUT /mirror`), heartbeats `platform/resources/<server>/heartbeat` every
# ten seconds (how the console finds it), runs the policy pass every 600 s, and keeps an `EventIndex`
# over the tree — rebuilt on every start, tailed every three seconds — which is what the console's
# `/events` asks. What a subsystem keeps in storage of its own is not its business. Checked by
# `tests/test_deploy_units.py` (`/data/platform/objects` read-write, for the heartbeat; `User=2100`).
#
# - `Description=w2c resource — the policy pass, the heartbeat, the event index`
#
# - It runs as `w2c` (`User=2100`), not root (the owner's decision, 4 October): the events archive is the
#   platform's and this is its service. `/data/platform/events` is `w2c`'s, mode 2770, group `w2c-events`; every
#   process that writes buckets there is a CLIENT — `GroupAdd=2102` and the umask 0007 in its unit — so each bucket
#   it makes is 0660 in directories 2770 of that group, and this process, a member, deletes it by its retention,
#   mirrors it and restores it. Only this process deletes a bucket there. It joins `w2c-store` (2103) for the two file
#   stores: it writes its heartbeat and `platform/doors/<server>`, and takes the rows' lock to do so.
#   `test_the_resource_as_w2c_deletes_a_bucket_a_client_of_w2c_events_wrote` holds the modes;
#   `test_the_platforms_processes_run_as_w2c_and_every_writer_is_a_client_of_its_group` the lines below.
#
# - `Image=localhost/vmsserver:latest`
#
# - `RestartSec=2`.
#
# - `WantedBy=multi-user.target`.
#
# ## Notes
# - The event index keeps nothing of its own: it reads the buckets where they lie at each query and caches
#   what it read (64 MiB by default). A restart loses the cache and nothing else; there is nothing to
#   rebuild and no `EVENTDB` to set.
# - `RESOURCE_HOST=127.0.0.1`: on one box nobody but the console asks it. In М11 the job listens on the
#   node's IP and its peers PUT mirrors to it.
# - Idempotent by construction, like the old timer pass: `retain` returns `0` when nothing is past its
#   cutoff, `mirror` `0` when every closed bucket already has its copy.
# ================================================================================================
[Unit]
Description=w2c resource — the policy pass, the heartbeat, the event index
After=network.target

[Container]
Image=localhost/vmsserver:latest
# the platform's `resource` verb (`w2cplatform/host.py`): the platform's Resource over the specs, served,
# heartbeating, its event index answering /events — no subsystem's code in it.
Exec=python3 -m w2cplatform resource
# the platform's user and its primary group, by number: the container has no /etc/passwd of the host's.
User=2100
Group=2100
Environment=RESOURCE_HOST=127.0.0.1
Environment=RESOURCE_PORT=8090
# `PLATFORM_DIR` (to read the rows the specs name and write the heartbeat) and `RESOURCE_ROOT` from the platform's
# file; the deployment's file as every unit reads it.
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# read-write: the heartbeat is an object under `platform/resources/<server>/`. Of the rows it reads each
# subsystem's `<sub>/retention[/<unit>]`, the rows a spec's `holds:` names, the rows of units ABOUT another (whose
# their buckets are), `platform/mirror`, and writes `platform/doors/<server>` (where it answers) and a subsystem's
# request to free bytes (`requests: {free: true}`).
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
# read-write: `retain` deletes expired bucket files, and a peer's mirror copies would land under `.mirror/`
# (none on one box). No volume lives under it: the box's own is the VMS's, `/data/vms/obsd/volume`.
Volume=/data/platform/events:/data/platform/events:z
# its own archive, and a member of its clients' group: what a client writes there, this process deletes.
GroupAdd=2102
# 127.0.0.1:8090 is the box's own; no mapping.
Network=host

[Service]
# the resource holds nothing a restart loses but a cache: the index reads the buckets where they lie, the
# heartbeat is rebuilt from the tree.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
