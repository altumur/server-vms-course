# The domain's lines of /etc/w2c/w2c.env (the platform's file; `w2c-run.sh` reads it under what each unit says).
#
# Every server of a member cluster:
CLUSTER=north                                # this cluster's name in the domain
DOMAIN_URL=https://holder.site:8445          # the domain's door: the agent carries through it, signed by its member key
#REACHES=vlan:a,vlan:b                       the site's names for the networks this cluster sees
#RELAY=1                                     a relay: keeps its members' answers in memory, answers them on RELAY_PORT
#RELAY_URL=http://relay.site:8446            a member that reaches only its relay (and RELAY_OBJECTS_URL)
#REPORT=1                                    a member the domain never reaches: its reports to DOMAIN_OBJECTS_URL
#
# The server that holds the domain:
#DOMAIN_ID=acme
#CLUSTERS=north,south=report                 a bare name: this server's own cluster, by each unit's socket and OBJECTS
#DOMAIN_HOLDER=north
#CONSOLE_URL=https://holder.site:8444        the domain console's address: the signer's view names it, the clusters' consoles hand /domain/* there
#SIGNER_URL=https://holder.site:8445         the signer's own address, said in the holder record it claims (Lesson 15)
#DOMAIN_CONFIG_URL=configstore:///run/configstore/domainagent.sock   the holder's own agent reads its own store (no DOMAIN_URL)
#RECOVERY_FILE=/root/acme.recovery           the first start only: the root signs the holder's issuing certificate
