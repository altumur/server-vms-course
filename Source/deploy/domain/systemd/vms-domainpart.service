# /etc/systemd/system/vms-domainpart.service — the VMS's worker on the domain, on the server that holds it
# (`w2c-run.sh vms domainpart`): the books' pass for every member (sources, primaries, polls, upstream, asks), its slot
# and heartbeat under `domain/vms/`, its door (/metrics, /catalog); the tokens its books carry asked of the signer, on its
# socket in `/run/w2c-signer` — whose group, `vms-vmsdomaintokens`, this unit alone joins (ADR-0031: the tokens socket's
# own group, one member; not the store's role group, `vms-vmsdomain`, whose members are whoever opens that socket).
[Unit]
Description=vms domain worker — the VMS's books for every member (this server holds the domain)
After=network-online.target configstore.service w2c-domain.service
Wants=network-online.target

[Service]
User=vms
Group=vms
SupplementaryGroups=vms-vmsdomain vms-vmsdomaintokens w2c-store w2c-secrets
Environment=PLATFORM_STORE=configstore:///run/configstore/vmsdomain.sock
Environment=SIGNER_TOKENS_UNIX=/run/w2c-signer/tokens.sock
Environment=DOMAINPART_PORT=8096
Environment=BOOKS_EVERY=5
LoadCredential=platform.key:/etc/w2c/secrets/platform.key
Environment=SECRETS_KEY=%d/platform.key
# /etc/w2c/w2c.env, then /etc/vms/vms.env: read by w2c-run.sh UNDER what this unit says (the cluster's units' rule) —
# the site's lines (CLUSTER, DOMAIN_URL, CLUSTERS, OBJECTS…) are there, `domain.env.example`; the sockets are the unit's.
UMask=0007
ExecStart=/opt/w2c/bin/w2c-run.sh vms domainpart
ReadWritePaths=/data/platform/objects
Restart=always
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
