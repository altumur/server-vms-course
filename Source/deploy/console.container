# /etc/containers/systemd/console.container — the console: the page and
# the API, its own process on this box (a system job on every server in М11,
# nothing in front). Its token writes the operator's rows only — vms/cameras/*,
# vms/next_id, vms/retention/*, vms/idem/* — and never placement; a camera
# created here is placed by the controller's next pass. It holds no footage: a
# timeline and an export are asked of the recorders' archive doors. The archive
# is writable because an operator's marks are the console's own buckets,
# console/<instance>/…, on it.
# ================================================================================================
# NOTES — what every part of this file does and why (kept beside the code, not in a separate document)
# ================================================================================================
# # console.container — the console: the page and the API as its own process, with the operator's token
# and
# never placement
#
# **Role.** The Quadlet unit for `console` at `/etc/containers/systemd/console.container`. It runs
# `python3 -m vms console`: `SpecConsole` over the VMS spec with the VMS's media routes, on
# `0.0.0.0:8080`. Its own process (a system job on every server in М11, nothing in front) with its own token
# — `vms/cameras/*`, `vms/next_id`, `vms/retention/*`, `vms/idem/*` (`SPEC.acl_console()`) — and never
# placement: a camera created here is placed by the controller's next pass. The header comment states the
# mounts' reasoning: no footage is mounted — `/timeline` and `/export` ask the recorders' doors — and the
# archive is writable because an operator's marks are the console's own buckets, `console/<instance>/…`, on it.
# Checked by `tests/test_deploy_units.py`.
#
# - `Description=VMS console — the operator's rows, the read model, the page`
#
# - `Image=localhost/vmsserver:latest`
#
# - `RestartSec=2`.
#
# - `WantedBy=multi-user.target`.
#
# ## Notes
# - The split with the controller unit is the two ACLs cut from `vms/*` (see `w2cplatform/spec.py`): this
#   token cannot `place`, and `test_the_console_over_http` proves it with a `Forbidden`. Deleting a camera
#   here marks the row; the placement is taken back by `vmscontroller`'s next `unplace_deleted`.
# - "Count as many as you like" (`__main__.console` docstring): several consoles over one store are safe;
#   `test_a_retry_that_lands_on_another_console_is_one_camera`.
# ================================================================================================
[Unit]
Description=VMS console — the operator's rows, the read model, the page
# it listens on a port, so it waits for the network.
After=network.target

[Container]
Image=localhost/vmsserver:latest
# the `console` verb: a `VmsController` opened as writer `console` with the console ACL, and
# `vms.console.serve(...)` over `$ARCHIVE` for its marks.
Exec=python3 -m vms console
# listen on every interface (the code's default is `127.0.0.1`); with `Network=host` this is the box's
# :8080. Plain HTTP, and the console says so in its log at every start (`w2cplatform/console.py`, `say_where`):
# kept because on one box the page is opened from the operator's own machine and nothing here ships a TLS
# proxy. With one in front, set `127.0.0.1` here and name the proxy in `TRUSTED_PROXY` (the emergency entry's
# limit then counts the address the proxy saw, not the proxy).
Environment=CONSOLE_HOST=0.0.0.0
# the port the README's `PLATFORM_DIR=… python3 -m vms controller  # the console on :8080` line refers to;
# the page, `/spec`, `/cameras`, `/where`, `/metrics`, `/marks`, `/timeline`, `/export` all live here.
Environment=CONSOLE_PORT=8080
# THE BOX'S OWN DOOR (the review's sixth pass): the same console on a unix socket, beside the port. Who is "on the
# box" — for the emergency entry's own turns (`Gate.open_glass`) and for connections of its own when the port is
# flooded (`w2cplatform/console.py`, `Bounds`) — is whoever came through this socket, and who may is the mode of
# the directory (0700 root, `vms.tmpfiles`) and of the socket (0660): no caller on the network, no proxy, and no
# process of the box that is not root. On the box: `curl --unix-socket /run/vms-console/console.sock
# http://console/session -d '{"glass": {…}}'`; from the operator's machine: `ssh -L 8080:/run/vms-console/console.sock
# root@box`, and a browser at http://localhost:8080. A TCP peer of 127.0.0.1 is the network's, like any other.
Environment=CONSOLE_UNIX=/run/vms-console/console.sock
Volume=/run/vms-console:/run/vms-console:z
# Who scrapes `/metrics` (the review's seventh pass): addresses or networks, comma-separated. They get four
# connections of their own, which a flood from the network cannot take; anyone else is answered `/metrics` only from
# the common slots. Set it to Prometheus's address in `vms.env` (`CONSOLE_MONITORS=10.0.0.5`); unset — no lane.
#Environment=CONSOLE_MONITORS=10.0.0.5
# `PLATFORM_DIR`, `ARCHIVE` (both the platform's, `w2c.env`), `CAPACITY` (the fallback capacity its controller object carries; it
# never places, so it is unused in practice), `LOG_LEVEL`.
EnvironmentFile=/etc/w2c/w2c.env
EnvironmentFile=/etc/vms/vms.env
# read-write: the console's token writes camera rows, `next_id`, derived retention rows and idempotency
# keys, and reads heartbeats for the read model.
# The platform's two file stores, and nothing else of /data/platform (its etc/ holds the key ring): setgid
# `w2c-store`, joined by number; every file this process makes there is its group's (`--umask=0007`).
Volume=/data/platform/config:/data/platform/config:z
Volume=/data/platform/objects:/data/platform/objects:z
GroupAdd=2103
PodmanArgs=--umask=0007
# The cluster's key (`w2cplatform/sealing.py`): the console seals device passwords with it, the holder opens
# them for the pipeline. Mounted, as one file, into these units ONLY — never inside a store, where it would be copied
# with every copy of it; `/etc/w2c/secrets` (a link into /data/platform/etc) is mounted nowhere else, and no unit mounts
# /data/platform whole. `python3 -m w2cplatform.sealing new /etc/w2c/secrets/platform.key`.
Volume=/etc/w2c/secrets/platform.key:/run/secrets/platform.key:ro,z
# the key ring is 0640, group `w2c-secrets`: a process that seals or opens a secret joins it, by number.
GroupAdd=2104
Environment=SECRETS_KEY=/run/secrets/platform.key
# read-write, as the header says: operator marks are the console's own event buckets,
# `console/<hostname:pid>/e1/…` on this server's resource (`POST /marks` → `SpecConsole.mark`), and that is
# the one thing it writes there. It never touches
# `vms/<cam>/…`, whose buckets have one writer, the worker holding the epoch.
Volume=/data/platform/events:/data/platform/events:z
# a CLIENT of the platform's events archive: `w2c-events`, by number — what it writes there the resource deletes.
GroupAdd=2102
# the port is the box's own; no mapping.
Network=host

[Service]
# the console holds nothing: idempotency keys are in the store (`vms/idem/*`), so a retry that reaches the
# restarted instance (or another one) gets the same reply. Marks use epoch 1 forever because `hostname:pid`
# names a fresh log per instance.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
